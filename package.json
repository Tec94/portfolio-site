{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:portfolio-content && vite build",
    "lint": "eslint .",
    "lint:portfolio": "eslint src/App.tsx src/main.tsx src/components/CustomCursorManager.tsx src/components/ErrorBoundary.tsx src/components/SystemPage.tsx src/components/v2 src/pages/NotFound.tsx src/portfolio src/data/portfolioData.ts src/lib/contactSubmissions.ts src/hooks/usePrefersReducedMotion.ts src/test scripts/validate-portfolio-content.ts portfolioMdxSourcePlugin.ts vite.config.ts vitest.config.ts",
    "type-check:portfolio": "npm run validate:portfolio-content && tsc -p tsconfig.portfolio.json --noEmit",
    "validate:portfolio-content": "tsx scripts/validate-portfolio-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:previews": "node scripts/generate-project-previews.cjs",
    "generate:world-map": "node scripts/generate-world-map-data.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@calcom/embed-react": "^1.5.3",
    "@gsap/react": "^2.1.2",
    "@mdx-js/react": "^3.1.1",
    "@statsig/react-bindings": "^3.26.0",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "aos": "^2.3.4",
    "cuelume": "^0.2.2",
    "framer-motion": "^12.23.22",
    "gray-matter": "^4.0.3",
    "gsap": "^3.13.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "three": "^0.180.0",
    "uisfx": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@mdx-js/rollup": "^3.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.35",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.10"
  }
}
